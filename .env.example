# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, never exposed to the browser. Used by the
# generation pipeline (lib/generatePost.ts) and the cron route, since a
# cron-triggered run has no logged-in user session to scope queries to.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this deployment (used to build the LinkedIn redirect_uri
# and Supabase auth email redirect links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Custom LinkedIn OAuth 2.0 app (NOT Supabase's built-in LinkedIn provider,
# because it can't request the w_member_social scope).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match a redirect URL registered on the LinkedIn app, e.g.
# https://yourdomain.com/api/linkedin/callback
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback

# Used by lib/openai.ts to rewrite articles, write the final post, and
# generate the post image (gpt-image-1).
OPENAI_API_KEY=

# Shared secret for /api/cron/generate. Set the SAME value on Vercel's
# CRON_SECRET env var — Vercel automatically sends it as
# `Authorization: Bearer <value>` on every cron-triggered request, so the
# route can reject anyone else who finds the URL.
CRON_SECRET=
