# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, never exposed to the browser. Used only
# where RLS must be bypassed (currently: none of the app code needs it,
# kept here for future server-side jobs run from this app).
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this deployment (used to build the LinkedIn redirect_uri
# and Supabase auth email redirect links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Custom LinkedIn OAuth 2.0 app (NOT Supabase's built-in LinkedIn provider,
# because it can't request the w_member_social scope).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match a redirect URL registered on the LinkedIn app, e.g.
# https://yourdomain.com/api/linkedin/callback
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback

# n8n workflow that fetches RSS feeds and generates post drafts.
# Called server-side only when the user clicks "Genera ora".
N8N_GENERATE_WEBHOOK_URL=
