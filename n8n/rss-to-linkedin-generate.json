    {
      "parameters": {
        "jsCode": "const rawExisting = $('Get Existing Guids').all().map(i => i.json);\nlet existingRows = rawExisting;\nif (rawExisting.length === 1 && Array.isArray(rawExisting[0])) {\n  existingRows = rawExisting[0];\n} else if (rawExisting.length === 1 && rawExisting[0] && rawExisting[0].data) {\n  existingRows = rawExisting[0].data;\n}\nconst existing = new Set(existingRows.map(r => r.guid).filter(Boolean));\n\nconst keywords = ['hotel', 'travel', 'revenue', 'strategy', 'trend', 'ai', 'stratup', 'tip', 'price', 'pricing', 'ota', 'loyalty', 'experience', 'expedia', 'booking.com', 'airbnb'];\n\nconst candidates = $input.all()\n  .map(item => ({ ...item.json, guid: item.json.guid || item.json.link }))\n  .filter(a => a.guid && !existing.has(a.guid));\n\nconst scored = candidates.map(a => {\n  const content = ((a.title || '') + ' ' + (a.contentSnippet || '')).toLowerCase();\n  let score = 0;\n  keywords.forEach(word => { if (content.includes(word)) score += 1; });\n  return { ...a, score };\n});\n\nscored.sort((a, b) => b.score - a.score);\n\nreturn scored.length > 0 ? [{ json: scored[0] }] : [];"
      },
